# Free key from https://aistudio.google.com/apikey. Copy this file to .env.local and paste it in.
GEMINI_API_KEY=
# Optional: a Gemini model to try before the built-in list.
# GEMINI_MODEL=

# Set automatically on Vercel when a Neon database is connected to the project.
# Without it, groups are saved to data/groups.json on this computer.
# DATABASE_URL=
